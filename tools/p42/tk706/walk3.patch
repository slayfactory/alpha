+/// Одна сделка ленты (время `ms`, цена `px`; `s` — знак стороны); `true` — ход кончен, выход записан в `w.exit`.
+#[inline(always)]
+#[allow(clippy::too_many_arguments)]
+fn walk_step(
+    w: &mut WSt,
+    pos: &mut Pos,
+    marks: &mut Vec<(usize, i64)>,
+    ex: &ExitCfg,
+    s: i64,
+    ms: i64,
+    px: i64,
+) -> bool {
+    let d = (ms / DAY_MS) as usize;
+    while w.cur_day < d {
+        marks.push((w.cur_day, s * w.last.1));
+        w.cur_day += 1;
+    }
+    let p = s * px;
+    w.last = (ms, p);
+    if let Some((lpx, live, arrival)) = w.lim {
+        if ms < live {
+            // приказ в пути (задержка выхода): как окно задержки рыночного выхода — сделки только исполняют тейки
+            pos.fill_takes(ms, p);
+            w.lim = Some((lpx, live, p));
+            return false;
+        }
+        // `tl = 2`: к приходу приказа цена уже строго за ним — приказ маркетабелен и исполняется как рыночный выход v21 (тейкер по сделке, с проскальзыванием)
